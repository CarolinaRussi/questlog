{
  "name": "@questlog/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch",
    "check:db": "tsx src/db/init-db.check.ts",
    "check:profile": "tsx src/use-cases/profile.check.ts",
    "check:quest": "tsx src/use-cases/quest.check.ts",
    "check:commit": "tsx src/use-cases/commit.check.ts",
    "check:ticket-match": "tsx src/use-cases/ticket-match.check.ts",
    "check:seed": "tsx src/use-cases/seed.check.ts",
    "check:ticket-snapshot": "tsx src/use-cases/ticket-snapshot.check.ts",
    "check:jira-resolution": "tsx src/integrations/jira-resolution.check.ts",
    "check:refresh-jira": "tsx src/use-cases/refresh-jira.check.ts",
    "check:secrets": "tsx src/use-cases/secrets.check.ts",
    "check:complement-epic-notes": "tsx src/use-cases/complement-epic-notes.check.ts",
    "check:accompanied": "tsx src/use-cases/accompanied.check.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.26",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2"
  }
}
