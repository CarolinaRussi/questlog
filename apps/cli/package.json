{
  "name": "@questlog/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "questlog": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed": "tsx src/index.ts seed",
    "import-jira": "tsx src/index.ts import-jira",
    "refresh-jira": "tsx src/index.ts refresh-jira",
    "ingest-commit": "tsx src/index.ts ingest-commit",
    "remind": "tsx src/index.ts remind",
    "check:paths": "tsx src/lib/paths.check.ts"
  },
  "dependencies": {
    "@questlog/core": "workspace:*",
    "dotenv": "17.2.1",
    "tsx": "^4.20.4"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  }
}
